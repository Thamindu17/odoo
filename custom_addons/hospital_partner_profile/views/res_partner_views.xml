<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================== -->
    <!-- Hospital Partner Profile — Form View Extension                      -->
    <!-- ================================================================== -->
    <record id="view_partner_hospital_form" model="ir.ui.view">
        <field name="name">res.partner.form.hospital</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">

            <!-- Hide default Odoo fields from the header / core groups -->
            <xpath expr="//h1" position="replace">
                <h1>
                    <!-- Completely replace native title inputs with read-only custom display value -->
                    <field name="hp_display_name_custom" readonly="1" class="w-100" style="width: 100%; min-width: 100%; display: block;"/>
                </h1>
            </xpath>

            <xpath expr="//field[@name='company_name'][1]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='parent_id'][1]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='vat'][1]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='function'][1]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='website'][1]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='category_id'][1]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='street'][1]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='street2'][1]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='city'][1]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='zip'][1]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='state_id'][1]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='country_id'][1]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- Hide native Address block to prevent overlap -->
            <xpath expr="//span[@name='address_name']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//span[@name='address_name']/following-sibling::div[hasclass('o_address_format')]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- Hide Reference natively -->
            <xpath expr="//field[@name='ref'][1]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- Hide Notebook Tabs: Contacts, Sales & Purchase (keep Notes) -->
            <xpath expr="//notebook/page[@name='contact_addresses']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//notebook/page[@name='sales_purchases']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- Add Partner Doctor Tab -->
            <xpath expr="//notebook/page[@name='internal_notes']" position="before">
                <page name="partner_doctor" string="Partner Doctor" invisible="company_type != 'person'">
                    <group>
                        <group>
                            <field name="hp_is_doctor" string="Doctor"/>
                            <field name="hp_specialization"
                                   string="Medical Specialization"
                                   invisible="not hp_is_doctor"/>
                        </group>
                    </group>
                </page>
            </xpath>

            <!-- Inject hospital sections before the default core group -->
            <xpath expr="//sheet/group[1]" position="before">
                <group name="hp_hospital_layout">

                    <!-- ======================================================= -->
                    <!-- LEFT COLUMN: PERSON DETAILS                              -->
                    <!-- ======================================================= -->
                    <group string="PERSON DETAILS"
                           name="hp_person_details"
                           invisible="company_type != 'person'">

                        <field name="hp_salutation" string="Title" required="company_type == 'person'"/>
                        <field name="hp_first_name" required="company_type == 'person'"/>
                        <field name="hp_last_name" required="company_type == 'person'"/>
                        <field name="hp_gender"/>
                        <field name="hp_birthday" required="company_type == 'person'"/>
                        <field name="hp_nic"
                               string="NIC"
                               required="company_type == 'person'"
                               placeholder="e.g. 199023456789 or 901234567V"/>

                        <label for="hp_address_line1" string="Address"/>
                        <div>
                            <field name="hp_address_line1" placeholder="Address Line 1"/>
                            <field name="hp_address_line2" placeholder="Address Line 2"/>
                            <field name="hp_city_category" placeholder="City" required="company_type == 'person'"/>
                        </div>

                        <field name="hp_occupation"/>
                        <field name="hp_employer"/>
                    </group>

                    <!-- ======================================================= -->
                    <!-- RIGHT COLUMN: CONTACT & STATUS                           -->
                    <!-- ======================================================= -->
                    <group string="CONTACT"
                           name="hp_contact_details"
                           invisible="company_type != 'person'">

                        <field name="phone" string="Contact Number" placeholder="e.g. 07XXXXXXXX" required="company_type == 'person'"/>
                        <field name="hp_whatsapp" string="WhatsApp Number" placeholder="e.g. 07XXXXXXXX"/>
                        <field name="email"/>

                        <separator string="PARTNER STATUS"/>
                        <field name="hp_is_vip" string="VIP Client" readonly="hp_is_doctor"/>
                        <field name="hp_is_corporate" string="Corporate Client" readonly="hp_is_doctor"/>
                    </group>

                    <!-- ======================================================= -->
                    <!-- COMPANY DETAILS                                           -->
                    <!-- ======================================================= -->
                    <group string="COMPANY DETAILS"
                           name="hp_company_details"
                           invisible="company_type != 'company'">

                        <field name="hp_company_name" required="company_type == 'company'"/>
                        <field name="name" invisible="1"/>
                        <field name="hp_location" required="company_type == 'company'"/>

                        <label for="hp_address_line1" string="Address"/>
                        <div>
                            <field name="hp_address_line1" placeholder="Address Line 1"/>
                            <field name="hp_address_line2" placeholder="Address Line 2"/>
                            <field name="hp_city_category" placeholder="City"/>
                        </div>
                    </group>

                    <group string="CONTACT"
                           invisible="company_type != 'company'">
                        <field name="phone" string="Contact Number" placeholder="e.g. 07XXXXXXXX"/>
                        <field name="hp_whatsapp" string="WhatsApp Number" placeholder="e.g. 07XXXXXXXX"/>
                        <field name="email"/>
                    </group>

                </group>
            </xpath>

        </field>
    </record>

    <!-- ================================================================== -->
    <!-- Extend partner search view                                          -->
    <!-- ================================================================== -->
    <record id="view_partner_hospital_search" model="ir.ui.view">
        <field name="name">res.partner.search.hospital</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_res_partner_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">

                <field name="ref"
                       string="Reference Number"
                       filter_domain="[('ref','ilike',self)]"/>

                <field name="hp_first_name"
                       string="First Name"
                       filter_domain="[('hp_first_name','ilike',self)]"/>

                <field name="hp_last_name"
                       string="Last Name"
                       filter_domain="[('hp_last_name','ilike',self)]"/>

                <field name="hp_nic"
                       string="NIC"
                       filter_domain="[('hp_nic','ilike',self)]"/>

                <field name="hp_nic_normalized"
                       string="NIC (Normalized)"
                       filter_domain="[('hp_nic_normalized','ilike',self)]"/>

                <separator/>

                <filter string="Doctors"
                        name="hp_doctors"
                        domain="[('hp_is_doctor','=',True)]"/>

                <filter string="VIP"
                        name="hp_vip"
                        domain="[('hp_is_vip','=',True)]"/>

                <filter string="Corporate"
                        name="hp_corporate"
                        domain="[('hp_is_corporate','=',True)]"/>

            </xpath>
        </field>
    </record>

    <!-- ================================================================== -->
    <!-- Hide Account Tabs                                                   -->
    <!-- ================================================================== -->
    <record id="view_partner_hospital_form_account" model="ir.ui.view">
        <field name="name">res.partner.form.hospital.account</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="account.view_partner_property_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='accounting']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//page[@name='accounting_disabled']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>

</odoo>