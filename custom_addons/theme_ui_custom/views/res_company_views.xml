<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_inherit_branding" model="ir.ui.view">
        <field name="name">res.company.form.inherit.branding</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='general_info']" position="after">
                <page name="ui_branding" string="UI Branding">
                    <group>
                        <group string="Logo &amp; Images">
                            <field name="ui_logo" widget="image"/>
                            <field name="ui_login_background" widget="image"/>
                        </group>
                        <group string="Colors &amp; Fonts">
                            <field name="primary_color" placeholder="#875A7B"/>
                            <field name="secondary_color" placeholder="#00A09D"/>
                            <field name="font_family"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="ui_custom_css"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
