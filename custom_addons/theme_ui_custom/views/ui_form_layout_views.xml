<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ui_form_layout_tree" model="ir.ui.view">
        <field name="name">ui.form.layout.tree</field>
        <field name="model">ui.form.layout</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="model_id"/>
                <field name="model_name"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-success="state == 'applied'" decoration-danger="state == 'error'"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_ui_form_layout_form" model="ir.ui.view">
        <field name="name">ui.form.layout.form</field>
        <field name="model">ui.form.layout</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="draft,applied"/>
                    <button name="action_validate_layout" type="object" string="Validate (Dry Run)" class="btn-secondary" invisible="state != 'draft'"/>
                    <button name="action_refresh_layout" type="object" string="Apply Layout" class="oe_highlight" invisible="state not in ('draft', 'error')"/>
                    <button name="action_remove_layout" type="object" string="Remove Layout" invisible="state != 'applied'"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Layout Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="model_id" options="{'no_create': True}"/>
                            <field name="model_name" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="sequence"/>
                            <field name="active"/>
                            <field name="view_id" readonly="1"/>
                        </group>
                    </group>
                    <notebook>

                        <page name="json_config" string="JSON Configuration (Advanced)">
                            <div class="alert alert-warning mb-3" role="alert">
                                <i class="fa fa-exclamation-triangle"/> 
                                Manual JSON editing is for advanced users. Use the Visual Layout Builder for easier configuration.
                            </div>
                            <field name="layout_config" widget="json" mode="edit"/>
                            <div class="alert alert-info mt-2" role="alert">
                                <strong>Configuration Format:</strong>
                                <pre>{
    "tabs": [
        {"name": "Tab 1", "fields": ["field1", "field2"]},
        {"name": "Tab 2", "fields": ["field3"]}
    ],
    "fields": ["field1", "field2", "field3"]
}</pre>
                            </div>
                        </page>
                        <page name="error" string="Error Details" invisible="state != 'error'">
                            <div class="alert alert-danger" role="alert">
                                <strong>Error:</strong>
                                <field name="error_message" readonly="1"/>
                            </div>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_ui_form_layout" model="ir.actions.act_window">
        <field name="name">Form Layouts</field>
        <field name="res_model">ui.form.layout</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first form layout
            </p>
            <p>
                Configure custom form layouts to control field ordering and grouping.
                Use the Visual Layout Builder for drag-and-drop configuration.
            </p>
        </field>
    </record>

    <menuitem id="menu_ui_form_layout_root"
              name="UI Customization"
              parent="base.menu_administration"
              sequence="50"
              groups="theme_ui_custom.group_ui_admin"/>

    <menuitem id="menu_ui_form_layout"
              name="Form Layouts"
              parent="menu_ui_form_layout_root"
              action="action_ui_form_layout"
              sequence="10"/>
</odoo>
