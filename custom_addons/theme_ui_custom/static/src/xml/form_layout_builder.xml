<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="theme_ui_custom.FormLayoutBuilder">
    <div class="form_layout_builder" t-ref="container" t-on-drop="onDropOnContainer">
        <div class="builder_container">
            <div class="builder_panel available_fields">
                <h4 class="panel_title">Available Fields</h4>
                <div class="field_list">
                    <t t-foreach="state.availableFields" t-as="field" t-key="field.id">
                        <div class="field_item"
                             draggable="true"
                             t-on-dragstart="(ev) => onDragStart(ev, field, 'available')">
                            <span class="field_name" t-esc="field.name"/>
                            <span class="field_description" t-esc="field.description"/>
                        </div>
                    </t>
                </div>
            </div>
            
            <div class="builder_panel layout_preview">
                <h4 class="panel_title">
                    Layout Preview
                    <button class="btn btn-sm btn-primary" t-on-click="addTab">+ Add Tab</button>
                </h4>
                
                <div class="layout_section">
                    <h5>Form Fields Order</h5>
                    <div class="field_list dropzone"
                         t-on-dragover="onDragOver"
                         t-on-drop="(ev) => onDrop(ev, 'fields')">
                        <t t-foreach="state.fields" t-as="field_name" t-key="field_name">
                            <div class="field_item placed">
                                <span class="field_name" t-esc="field_name"/>
                                <button class="btn btn-sm btn-link" t-on-click="() => removeField(field_name_index)">×</button>
                            </div>
                        </t>
                    </div>
                </div>
                
                <div class="tabs_section">
                    <h5>Tabs</h5>
                    <t t-foreach="state.tabs" t-as="tab" t-key="tab_index">
                        <div class="tab_container">
                            <div class="tab_header">
                                <input type="text" 
                                       class="form-control tab_name_input"
                                       t-att-value="tab.name"
                                       t-on-change="(ev) => updateTabName(tab_index, ev.target.value)"
                                       placeholder="Tab Name"/>
                                <button class="btn btn-sm btn-danger" t-on-click="() => removeTab(tab_index)">Remove</button>
                            </div>
                            <div class="field_list dropzone tab_dropzone"
                                 t-on-dragover="onDragOver"
                                 t-on-drop="(ev) => onDrop(ev, 'tab', tab_index)">
                                <t t-foreach="tab.fields || []" t-as="field_name" t-key="field_name">
                                    <div class="field_item placed in_tab">
                                        <span class="field_name" t-esc="field_name"/>
                                        <button class="btn btn-sm btn-link" t-on-click="() => removeFieldFromTab(tab_index, field_name_index)">×</button>
                                    </div>
                                </t>
                            </div>
                        </div>
                    </t>
                </div>
            </div>
        </div>
    </div>
</t>

</templates>
