<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── List View ─────────────────────────────────────────────────────── -->
    <record id="ruhunu_first_contact_response_view_list" model="ir.ui.view">
        <field name="name">ruhunu.first.contact.response.list</field>
        <field name="model">ruhunu.first.contact.response</field>
        <field name="arch" type="xml">
            <list string="First Contact Responses" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <!-- ── Form View ─────────────────────────────────────────────────────── -->
    <record id="ruhunu_first_contact_response_view_form" model="ir.ui.view">
        <field name="name">ruhunu.first.contact.response.form</field>
        <field name="model">ruhunu.first.contact.response</field>
        <field name="arch" type="xml">
            <form string="First Contact Response">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ── Window Action ─────────────────────────────────────────────────── -->
    <record id="ruhunu_first_contact_response_action" model="ir.actions.act_window">
        <field name="name">First Contact Responses</field>
        <field name="res_model">ruhunu.first.contact.response</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add a First Contact Response
            </p>
            <p>
                Define the possible outcomes recorded when first contact with a
                client is completed (e.g. Interested, Not Interested, Callback).
            </p>
        </field>
    </record>

    <!-- ── Menu Item ─────────────────────────────────────────────────────── -->
    <menuitem
        id="ruhunu_menu_first_contact_response"
        name="First Contact Responses"
        parent="ruhunu_menu_config"
        action="ruhunu_first_contact_response_action"
        sequence="50"
        groups="sales_team.group_sale_manager"/>

</odoo>
