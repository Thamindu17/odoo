<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── List View ─────────────────────────────────────────────────────── -->
    <record id="ruhunu_relation_to_client_view_list" model="ir.ui.view">
        <field name="name">ruhunu.relation.to.client.list</field>
        <field name="model">ruhunu.relation.to.client</field>
        <field name="arch" type="xml">
            <list string="Relations to Client" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <!-- ── Form View ─────────────────────────────────────────────────────── -->
    <record id="ruhunu_relation_to_client_view_form" model="ir.ui.view">
        <field name="name">ruhunu.relation.to.client.form</field>
        <field name="model">ruhunu.relation.to.client</field>
        <field name="arch" type="xml">
            <form string="Relation to Client">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ── Window Action ─────────────────────────────────────────────────── -->
    <record id="ruhunu_relation_to_client_action" model="ir.actions.act_window">
        <field name="name">Relations to Client</field>
        <field name="res_model">ruhunu.relation.to.client</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add a Relation to Client
            </p>
            <p>
                Define the possible relationships between a guardian and the
                patient (e.g. Father, Mother, Spouse, Sibling).
            </p>
        </field>
    </record>

    <!-- ── Menu Item ─────────────────────────────────────────────────────── -->
    <menuitem
        id="ruhunu_menu_relation_to_client"
        name="Relations to Client"
        parent="ruhunu_menu_config"
        action="ruhunu_relation_to_client_action"
        sequence="60"
        groups="sales_team.group_sale_manager"/>

</odoo>
