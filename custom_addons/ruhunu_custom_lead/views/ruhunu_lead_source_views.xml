<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── List View ─────────────────────────────────────────────────────── -->
    <record id="ruhunu_lead_source_view_list" model="ir.ui.view">
        <field name="name">ruhunu.lead.source.list</field>
        <field name="model">ruhunu.lead.source</field>
        <field name="arch" type="xml">
            <list string="Lead Sources" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <!-- ── Form View ─────────────────────────────────────────────────────── -->
    <record id="ruhunu_lead_source_view_form" model="ir.ui.view">
        <field name="name">ruhunu.lead.source.form</field>
        <field name="model">ruhunu.lead.source</field>
        <field name="arch" type="xml">
            <form string="Lead Source">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ── Window Action ─────────────────────────────────────────────────── -->
    <record id="ruhunu_lead_source_action" model="ir.actions.act_window">
        <field name="name">Lead Sources</field>
        <field name="res_model">ruhunu.lead.source</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Lead Source
            </p>
            <p>
                Lead Sources describe the channel through which a prospect reached you
                (e.g. Referral, Walk-In, Social Media).
            </p>
        </field>
    </record>

    <!-- ── Menu Items ────────────────────────────────────────────────────── -->
    <!--
        Parent: CRM > Configuration menu.
        External ID in standard Odoo CRM: crm.crm_menu_config
        If your Odoo build uses a different ID, update the parent attribute below.
    -->
    <menuitem
        id="ruhunu_menu_config"
        name="Ruhunu Config"
        parent="crm.crm_menu_config"
        sequence="99"
        groups="sales_team.group_sale_manager"/>

    <menuitem
        id="ruhunu_menu_lead_source"
        name="Lead Sources"
        parent="ruhunu_menu_config"
        action="ruhunu_lead_source_action"
        sequence="10"
        groups="sales_team.group_sale_manager"/>

</odoo>
