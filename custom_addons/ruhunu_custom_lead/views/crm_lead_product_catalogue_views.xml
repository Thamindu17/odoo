<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Product Catalogue Wizard
        ========================
        Opened when the operator clicks "Catalogue" inside the
        Revenue Tracking tab.  Displays a searchable product list
        (with reference, category, price, UoM columns) where multiple
        products can be selected and bulk-added as revenue lines.
    -->
    <record id="crm_lead_product_catalogue_view_form" model="ir.ui.view">
        <field name="name">crm.lead.product.catalogue.form</field>
        <field name="model">crm.lead.product.catalogue</field>
        <field name="arch" type="xml">
            <form string="Add Products from Catalogue">
                <sheet>
                    <!-- Hidden link back to parent lead -->
                    <field name="lead_id" invisible="True"/>
                    <field name="company_id" invisible="True"/>

                    <div class="o_row mb-2">
                        <h4>Select products to add to Revenue Lines</h4>
                    </div>

                    <!--
                        Many2many widget renders as an editable list with
                        checkboxes so the operator can tick multiple items.
                        Search bar is automatically available.
                    -->
                    <field name="product_ids"
                           widget="many2many"
                           domain="[('sale_ok', '=', True)]"
                           options="{'no_create': True, 'no_open': True}">
                        <list string="Products" decoration-muted="not active">
                            <field name="default_code"
                                   string="Ref."
                                   optional="show"/>
                            <field name="name" string="Product Name"/>
                            <field name="categ_id"
                                   string="Category"
                                   optional="show"/>
                            <field name="uom_id"
                                   string="Unit"
                                   optional="show"/>
                            <field name="lst_price"
                                   string="Sales Price"
                                   widget="monetary"/>
                            <field name="active" column_invisible="True"/>
                            <!-- currency_id needed by monetary widget -->
                            <field name="currency_id" column_invisible="True"/>
                        </list>
                    </field>
                </sheet>
                <footer>
                    <button string="Add to Revenue Lines"
                            name="action_add_products"
                            type="object"
                            class="btn-primary"/>
                    <button string="Cancel"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
