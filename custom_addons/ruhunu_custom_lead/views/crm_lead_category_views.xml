<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── List View ─────────────────────────────────────────────────────── -->
    <record id="ruhunu_lead_category_view_list" model="ir.ui.view">
        <field name="name">ruhunu.lead.category.list</field>
        <field name="model">ruhunu.lead.category</field>
        <field name="arch" type="xml">
            <list string="Lead Categories" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <!-- ── Form View ─────────────────────────────────────────────────────── -->
    <record id="ruhunu_lead_category_view_form" model="ir.ui.view">
        <field name="name">ruhunu.lead.category.form</field>
        <field name="model">ruhunu.lead.category</field>
        <field name="arch" type="xml">
            <form string="Lead Category">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ── Window Action ─────────────────────────────────────────────────── -->
    <record id="ruhunu_lead_category_action" model="ir.actions.act_window">
        <field name="name">Lead Categories</field>
        <field name="res_model">ruhunu.lead.category</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Lead Category
            </p>
            <p>
                Create a category named <b>Maternity</b> to enable the
                conditional Maternity Details section on the lead form.
            </p>
        </field>
    </record>

    <!-- ── Menu Item ─────────────────────────────────────────────────────── -->
    <menuitem
        id="ruhunu_menu_lead_category"
        name="Lead Categories"
        parent="ruhunu_menu_config"
        action="ruhunu_lead_category_action"
        sequence="20"
        groups="sales_team.group_sale_manager"/>

</odoo>
