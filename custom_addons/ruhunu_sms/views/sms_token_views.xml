<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="ruhunu_sms_token_view_tree" model="ir.ui.view">
        <field name="name">ruhunu.sms.token.tree</field>
        <field name="model">ruhunu.sms.token</field>
        <field name="arch" type="xml">
            <list string="SMS Tokens" decoration-danger="is_expired" decoration-success="is_active and not is_expired">
                <field name="id" string="Token ID"/>
                <field name="create_date" string="Created"/>
                <field name="expiration_time" string="Expires At"/>
                <field name="is_active" widget="boolean_toggle"/>
                <field name="is_expired" widget="boolean_toggle"/>
                <field name="wallet_balance" sum="Total"/>
                <field name="default_mask"/>
                <field name="user_id"/>
            </list>
        </field>
    </record>

    <record id="ruhunu_sms_token_view_form" model="ir.ui.view">
        <field name="name">ruhunu.sms.token.form</field>
        <field name="model">ruhunu.sms.token</field>
        <field name="arch" type="xml">
            <form string="SMS Token">
                <header>
                    <field name="is_active" widget="boolean_toggle" string="Active"/>
                    <field name="is_expired" widget="boolean_toggle" string="Expired"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>Token: <field name="id" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="create_date" string="Created Date" readonly="1"/>
                            <field name="expiration_time" readonly="1"/>
                            <field name="refresh_expiration_time" readonly="1"/>
                            <field name="user_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="wallet_balance" readonly="1"/>
                            <field name="default_mask" readonly="1"/>
                            <field name="user_mobile" readonly="1"/>
                            <field name="user_email" readonly="1"/>
                        </group>
                    </group>
                    <group string="Tokens">
                        <field name="token" readonly="1" colspan="2" password="True"/>
                        <field name="refresh_token" readonly="1" colspan="2" password="True"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="ruhunu_sms_token_action" model="ir.actions.act_window">
        <field name="name">SMS Access Tokens</field>
        <field name="res_model">ruhunu.sms.token</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_is_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No access tokens yet
            </p>
            <p>
                Access tokens will be generated automatically when sending the first SMS.
                Tokens are valid for 12 hours and will auto-refresh.
            </p>
        </field>
    </record>

    <menuitem id="ruhunu_sms_token_menu"
              name="Access Tokens"
              parent="crm.crm_menu_config"
              action="ruhunu_sms_token_action"
              sequence="105"/>

</odoo>
