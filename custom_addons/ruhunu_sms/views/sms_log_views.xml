<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="ruhunu_sms_log_view_tree" model="ir.ui.view">
        <field name="name">ruhunu.sms.log.tree</field>
        <field name="model">ruhunu.sms.log</field>
        <field name="arch" type="xml">
            <list string="SMS Logs" decoration-danger="state == 'failed'" decoration-success="state == 'sent'">
                <field name="name"/>
                <field name="create_date" string="Date Sent" widget="datetime"/>
                <field name="lead_id"/>
                <field name="phone_number"/>
                <field name="template_id" optional="show"/>
                <field name="message" width="40%" optional="show"/>
                <field name="character_count" optional="show"/>
                <field name="state" widget="badge" 
                       decoration-success="state == 'sent'" 
                       decoration-danger="state == 'failed'"
                       decoration-warning="state == 'draft'"/>
                <field name="sent_by_id" optional="show"/>
            </list>
        </field>
    </record>

    <record id="ruhunu_sms_log_view_form" model="ir.ui.view">
        <field name="name">ruhunu.sms.log.form</field>
        <field name="model">ruhunu.sms.log</field>
        <field name="arch" type="xml">
            <form string="SMS Log">
                <header>
                    <field name="state" widget="statusbar" 
                           statusbar_visible="draft,sent,failed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_lead" 
                                type="object" 
                                class="oe_stat_button" 
                                icon="fa-user"
                                string="View Lead">
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="lead_id" readonly="1"/>
                            <field name="phone_number" readonly="1"/>
                            <field name="template_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="create_date" string="Sent Date" readonly="1"/>
                            <field name="sent_by_id" readonly="1"/>
                            <field name="character_count" readonly="1"/>
                        </group>
                    </group>
                    <group string="Message Sent">
                        <field name="message" readonly="1" colspan="2" style="height: 100px;"/>
                    </group>
                    <group string="Gateway Response" invisible="not gateway_response">
                        <field name="gateway_response" readonly="1" colspan="2" style="height: 100px;"/>
                    </group>
                    <group string="Error Details" invisible="state != 'failed'">
                        <field name="error_code" readonly="1"/>
                        <field name="error_message" readonly="1" colspan="2"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="ruhunu_sms_log_view_search" model="ir.ui.view">
        <field name="name">ruhunu.sms.log.search</field>
        <field name="model">ruhunu.sms.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="lead_id"/>
                <field name="phone_number"/>
                <field name="sent_by_id"/>
                <filter string="Sent" name="sent" domain="[('state', '=', 'sent')]"/>
                <filter string="Failed" name="failed" domain="[('state', '=', 'failed')]"/>
                <filter string="Today" name="today" domain="[('create_date', '>=', context_today().strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter string="My SMS" name="my_sms" domain="[('sent_by_id', '=', uid)]"/>
                <group>
                    <filter string="Lead" name="group_lead" context="{'group_by': 'lead_id'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Sent By" name="group_user" context="{'group_by': 'sent_by_id'}"/>
                    <filter string="Date" name="group_date" context="{'group_by': 'create_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="ruhunu_sms_log_action" model="ir.actions.act_window">
        <field name="name">SMS Logs</field>
        <field name="res_model">ruhunu.sms.log</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="ruhunu_sms_log_view_search"/>
        <field name="context">{'search_default_sent': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No SMS logs yet
            </p>
            <p>
                SMS logs will appear here once you start sending SMS to leads.
            </p>
        </field>
    </record>

    <menuitem id="ruhunu_sms_log_menu"
              name="SMS Logs"
              parent="crm.crm_menu_config"
              action="ruhunu_sms_log_action"
              sequence="110"/>

</odoo>
