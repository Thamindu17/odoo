<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="ruhunu_sms_template_view_tree" model="ir.ui.view">
        <field name="name">ruhunu.sms.template.tree</field>
        <field name="model">ruhunu.sms.template</field>
        <field name="arch" type="xml">
            <list string="SMS Templates" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="category"/>
                <field name="active" widget="boolean_toggle"/>
                <field name="description" optional="show"/>
            </list>
        </field>
    </record>

    <record id="ruhunu_sms_template_view_form" model="ir.ui.view">
        <field name="name">ruhunu.sms.template.form</field>
        <field name="model">ruhunu.sms.template</field>
        <field name="arch" type="xml">
            <form string="SMS Template">
                <header>
                    <field name="active" widget="boolean_toggle" string="Active"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1><field name="name" placeholder="Template Name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="category"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="description" placeholder="Brief description of when to use this template"/>
                        </group>
                    </group>
                    <group string="Message Content">
                        <field name="content" 
                               placeholder="Enter your template content here. Use placeholders: {{first_name}}, {{appointment_date}}, {{phone_number}}, {{hospital_name}}, {{link}}"
                               colspan="2"
                               style="height: 120px;"/>
                    </group>
                    <group string="Available Placeholders">
                        <div class="text-muted">
                            <ul class="list-unstyled">
                                <li><code>{{first_name}}</code> or <code>{{lead_name}}</code> - Lead's first name</li>
                                <li><code>{{appointment_date}}</code> - Appointment date</li>
                                <li><code>{{phone_number}}</code> - Contact phone number</li>
                                <li><code>{{hospital_name}}</code> - Ruhunu Hospital</li>
                                <li><code>{{link}}</code> - Feedback/survey link</li>
                            </ul>
                        </div>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="ruhunu_sms_template_view_search" model="ir.ui.view">
        <field name="name">ruhunu.sms.template.search</field>
        <field name="model">ruhunu.sms.template</field>
        <field name="arch" type="xml">
            <search string="Search SMS Templates">
                <field name="name"/>
                <field name="category"/>
                <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                <filter string="Archived" name="archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter string="Category" name="group_category" context="{'group_by': 'category'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="ruhunu_sms_template_action" model="ir.actions.act_window">
        <field name="name">SMS Templates</field>
        <field name="res_model">ruhunu.sms.template</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="ruhunu_sms_template_view_search"/>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first SMS template
            </p>
            <p>
                SMS templates allow you to quickly send common messages to leads.
                Use placeholders like {{first_name}} to personalize messages.
            </p>
        </field>
    </record>

    <menuitem id="ruhunu_sms_template_menu"
              name="SMS Templates"
              parent="crm.crm_menu_config"
              action="ruhunu_sms_template_action"
              sequence="100"/>

</odoo>
